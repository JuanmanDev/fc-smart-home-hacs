# Local credentials template — copy to .env and fill in.
# .env is GITIGNORED: it will NEVER be committed. Do not put real
# credentials in this template.

FC_PHONE=your-phone-digits
FC_CC=34
FC_PASSWORD=your-password
FC_REGION=us
# optional: md5 of the account's security password (validateSecurityPassword)
FC_SECURITY_MD5=
